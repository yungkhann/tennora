{
  "name": "tennora",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium --project=mobile",
    "test:auth": "playwright test --project=auth",
    "test:db": "supabase test db",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/generate-db-types.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:env": "node scripts/setup-local-env.mjs",
    "test:staff-concurrency": "node scripts/test-staff-concurrency.mjs",
    "test:roster-concurrency": "node scripts/test-roster-concurrency.mjs",
    "test:league-scale": "node scripts/test-league-scale.mjs",
    "test:draw-concurrency": "node scripts/test-draw-concurrency.mjs",
    "test:lineup-concurrency": "node scripts/test-lineup-concurrency.mjs",
    "test:standings-parity": "node scripts/test-standings-parity.mjs",
    "test:standings-concurrency": "node scripts/test-standings-concurrency.mjs",
    "test:draw-adjustment-concurrency": "node scripts/test-draw-adjustment-concurrency.mjs",
    "test:scoring-parity": "node scripts/test-scoring-parity.mjs",
    "test:table-owner-concurrency": "node scripts/test-table-owner-concurrency.mjs",
    "test:match-start-concurrency": "node scripts/test-match-start-concurrency.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
